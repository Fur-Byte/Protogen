{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protogen qualification evidence v1",
  "type": "object",
  "required": ["schema_version", "source_sha", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "source_sha": {"$ref": "#/$defs/commit"},
    "records": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "notes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "hardware": {
      "type": "object",
      "required": ["boards", "firmware_sha256", "instruments", "operator", "date", "duration_seconds", "conditions", "measurements"],
      "additionalProperties": false,
      "properties": {
        "boards": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
        "firmware_sha256": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/digest"}},
        "instruments": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
        "operator": {"$ref": "#/$defs/text"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "conditions": {"$ref": "#/$defs/text"},
        "measurements": {"type": "object", "minProperties": 1, "maxProperties": 64,
                         "additionalProperties": {"type": ["number", "string"]}}
      }
    },
    "record": {
      "type": "object",
      "required": ["requirement_id", "source_sha", "feature_flags", "toolchain", "command", "result", "evidence_level",
                   "artifact", "environment", "hardware", "limitations", "outstanding_gates"],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,95}$"},
        "source_sha": {"$ref": "#/$defs/commit"},
        "feature_flags": {"type": "object", "maxProperties": 128,
                          "additionalProperties": {"type": ["integer", "string"]}},
        "toolchain": {"type": "object", "minProperties": 1, "maxProperties": 64,
                      "additionalProperties": {"$ref": "#/$defs/text"}},
        "command": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/text"}},
        "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "NOT_APPLICABLE", "UNQUALIFIED"]},
        "evidence_level": {"enum": ["F0", "F1", "F2", "F3"]},
        "artifact": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "environment": {
          "type": "object",
          "required": ["kind", "description"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["static", "host", "target-build", "physical"]},
            "description": {"$ref": "#/$defs/text"}
          }
        },
        "hardware": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hardware"}]},
        "limitations": {"$ref": "#/$defs/notes"},
        "outstanding_gates": {"$ref": "#/$defs/notes"}
      }
    }
  }
}
